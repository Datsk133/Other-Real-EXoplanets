@ParallaxTerrain
{
    @Body[Philonoe]
    {
        // Here is where the usual terrain config goes
        // This patches in the scaled properties
        ParallaxScaledProperties
        {
            // Possible modes:
            // FromTerrain
            // Baked
            // Custom
            // CustomRequiresTerrain

            // Altitude in meters
            minTerrainAltitude = -250
            maxTerrainAltitude = 4000
            mode = FromTerrain
            Material
            {
                _ColorMap = Pollux/PluginData/PhilonoeClr.dds
                _BumpMap = Pollux/PluginData/PhilonoeNrm.dds
                _HeightMap = Pollux/PluginData/PhilonoeH.dds
                _PlanetBumpScale = 0.75
                Keywords
                {
                    
                }
            }
            TerrainMaterialOverride
            {
                _SteepPower = 45
                _Tiling = 0.002
            }
        }
    }
    @Body[Timandra]
    {
        // Here is where the usual terrain config goes
        // This patches in the scaled properties
        ParallaxScaledProperties
        {
            // Possible modes:
            // FromTerrain
            // Baked
            // Custom
            // CustomRequiresTerrain

            // Altitude in meters
            minTerrainAltitude = -250
            maxTerrainAltitude = 4000
            mode = FromTerrain
            Material
            {
                _ColorMap = Pollux/PluginData/TimandraClr.dds
                _BumpMap = Pollux/PluginData/TimandraNrm.dds
                _HeightMap = Pollux/PluginData/TimandraNrm.dds
                _PlanetBumpScale = 0.75
                Keywords
                {
                    
                }
            }
            TerrainMaterialOverride
            {
                _SteepPower = 45
                _Tiling = 0.002
            }
        }
    }
}